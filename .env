# Actualmente todo esta en USO LOCAL (una sola máquina):
#   Los valores actuales funcionan directamente con docker compose.
#
# PARA USO MULTI-MÁQUINA:
#  Reemplazar los valores marcados con [CAMBIAR] por las IPs
#  reales de cada maquina o VM. El resto puede quedarse igual.



# Base de datos PostgreSQL
# [CAMBIAR en multi-máquina] → IP de la VM que corre postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=distributed_sys

# URL completa construida a partir de las variables anteriores
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Service Manager
# [CAMBIAR en multi-máquina] → IP de la VM que corre service_manager
SERVICE_MANAGER_HOST=service_manager
SERVICE_MANAGER_PORT=8001
SERVICE_MANAGER_URL=http://${SERVICE_MANAGER_HOST}:${SERVICE_MANAGER_PORT}

# Stats Service
# [CAMBIAR en multi-máquina] → IP de la VM que corre stats_service
STATS_SERVICE_HOST=stats_service
STATS_SERVICE_PORT=8002
STATS_SERVICE_URL=http://${STATS_SERVICE_HOST}:${STATS_SERVICE_PORT}


# API Gateway
# INSTANCE_ID debe ser único por cada instancia del gateway
GATEWAY_PORT=8000

# gateway_1 — si se despliega en VM separada, se debe cambiar en ESE compose
GATEWAY_1_INSTANCE_ID=gateway_1

# gateway_2
GATEWAY_2_INSTANCE_ID=gateway_2


# NGINX (Load Balancer)
# En multi-máquina hay que editar nginx.conf a mano con las IPs
# reales de cada gateway, para futuras iteraciones del proyecto
# se considerará usar la imagen nginx con envsubst.

# Estos valores sirven como referencia de lo que va de NGINX actualmente,
# No estan siendo usados desde aqui:
NGINX_GATEWAY_1=api_gateway_1:8000
NGINX_GATEWAY_2=api_gateway_2:8000
# En multi-máquina serían:
# NGINX_GATEWAY_1=192.168.1.20:8000
# NGINX_GATEWAY_2=192.168.1.30:8000
